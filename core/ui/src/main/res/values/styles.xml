<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LtechtestWidget.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/LtechtestTextAppearance.Body1</item>
    </style>

    <style name="LtechtestWidget.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_stroke_color_for_text_input_layout</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintEnabled">false</item>
        <item name="hintMaxLines">1</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="passwordToggleDrawable">@drawable/selector_password_toggle</item>
    </style>

    <style name="LtechtestWidget.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="LtechtestWidget.SurfaceButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">#20000000</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="LtechtestWidget.MaterialToolbar" parent="Widget.MaterialComponents.Toolbar.Surface">
<!--        <item name="android:background">?attr/colorSurface</item>-->
<!--        <item name="backgroundTint">?attr/colorSurface</item>-->
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurface</item>
        <item name="titleTextAppearance">@style/LtechtestTextAppearance.Headline3</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="LtechtestWidget.ModalBottomSheetDialog" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/light_white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>