<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graph_main"
    app:startDestination="@id/graph_feature_authorization"
    tools:ignore="InvalidNavigation">

    <include app:graph="@navigation/graph_feature_authorization" />
    <include app:graph="@navigation/graph_feature_home" />
    <include app:graph="@navigation/graph_feature_details" />

    <action
        android:id="@+id/action_to_feature_authorization"
        app:destination="@+id/graph_feature_authorization"
        app:popUpTo="@id/graph_feature_authorization"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_to_feature_home"
        app:destination="@+id/graph_feature_home"
        app:popUpTo="@id/graph_feature_authorization"
        app:popUpToInclusive="true">
        <argument
            android:name="sorting"
            android:defaultValue="DEFAULT"
            app:argType="com.sergokuzneczow.model.Sorting" />
    </action>

    <action
        android:id="@+id/action_to_feature_details"
        app:destination="@+id/graph_feature_details">
        <argument
            android:name="postKey"
            app:argType="string"
            android:defaultValue="033efe01-be68-486d-9f99-7b956aa07730" />
    </action>
</navigation>